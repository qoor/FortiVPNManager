<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app bundle in the component package. Not relocatable: Installer would otherwise update a copy of
  the app found elsewhere, such as a build in .build, instead of the one in /Applications. Not version
  checked: Distribution.xml decides which versions install.
-->
<plist version="1.0">
<array>
    <dict>
        <key>RootRelativeBundlePath</key>
        <string>FortiVPNManager.app</string>
        <key>BundleIsRelocatable</key>
        <false/>
        <key>BundleIsVersionChecked</key>
        <false/>
        <key>BundleHasStrictIdentifier</key>
        <true/>
        <key>BundleOverwriteAction</key>
        <string>upgrade</string>
    </dict>
</array>
</plist>
