<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Windows app: its entry, one copy per user, and the runtime, the OS integration and the UI joined.
    Built by packaging/windows/build.ps1, which sets the version to the app's (VERSION) and the
    informational version to the build the Helper carries too. The .NET runtime and Windows App SDK ship inside the app's folder, so the PC needs
    neither installed. Published, the app is compiled ahead of time (Native AOT): one native executable
    instead of the .NET runtime and the app's assemblies, which starts without compiling and takes
    less memory.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <AssemblyName>FortiVPNManager</AssemblyName>
    <RootNamespace>FortiVPNManager.App</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Without it, publishing leaves out the app's resources (FortiVPNManager.pri and the compiled XAML). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main lets only one copy start before XAML does. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The app icon (packaging/windows/AppIcon.ico, used as it is): the exe's, and the window's in the taskbar. -->
    <ApplicationIcon>..\..\..\..\packaging\windows\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\..\..\packaging\windows\AppIcon.ico" Link="AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\packaging\windows\TrayDisconnected.ico" Link="TrayDisconnected.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\packaging\windows\TrayInProgress.ico" Link="TrayInProgress.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\packaging\windows\TrayError.ico" Link="TrayError.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    Of the Windows App SDK, only the WinUI component, which takes Foundation, InteractiveExperiences
    and Base. The UI's tray icon and Community Toolkit packages take the whole SDK, pinned here as in
    the UI; its other components would put about 40 MB the app never uses into its folder, onnxruntime
    and DirectML of the AI and ML components above all, so none of their files are taken.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.4.89" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" ExcludeAssets="all" />
  </ItemGroup>
  <!--
    WinUI brings its controls' own text (such as a text field's Copy menu) in 86 languages, a folder each.
    The app speaks only Korean and English, so the published app keeps those two; on Windows in another
    language WinUI's text falls back to English, as the app's own does (user decision, 2026-11-15).
  -->
  <Target Name="KeepKoreanAndEnglishWinUIText" AfterTargets="ComputeResolvedFilesToPublishList">
    <!-- A condition cannot pass metadata to a property function, so the language folder is metadata first. -->
    <ItemGroup>
      <_WinUITextToDrop Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.mui'">
        <Language>$([System.IO.Path]::GetDirectoryName('%(ResolvedFileToPublish.RelativePath)'))</Language>
      </_WinUITextToDrop>
      <_WinUITextToDrop Remove="@(_WinUITextToDrop)" Condition="'%(Language)' == 'ko-KR' or '%(Language)' == 'en-US'" />
      <ResolvedFileToPublish Remove="@(_WinUITextToDrop)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\..\..\contract\windows\FortiVPNManager.Contract.csproj" />
    <ProjectReference Include="..\FortiVPNManager.OsIntegration.csproj" />
    <ProjectReference Include="..\..\..\ui\windows\FortiVPNManager.Ui.csproj" />
  </ItemGroup>
</Project>
