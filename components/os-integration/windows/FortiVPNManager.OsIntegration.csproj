<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows app's OS integration: the runtime in this process, the Helper's pipe, and the
       OS functions the runtime asks for. The WinUI app hosts it. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FortiVPNManager.OsIntegration</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\contract\windows\FortiVPNManager.Contract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FortiVPNManager.OsIntegration.Tests" />
    <!-- The app (assembly FortiVPNManager) writes its own faults to the same event log source. -->
    <InternalsVisibleTo Include="FortiVPNManager" />
  </ItemGroup>

  <!-- The app's entry is a project of its own in App/, which hosts this library. -->
  <ItemGroup>
    <Compile Remove="App\**" />
    <None Remove="App\**" />
    <Content Remove="App\**" />
    <EmbeddedResource Remove="App\**" />
  </ItemGroup>

</Project>
