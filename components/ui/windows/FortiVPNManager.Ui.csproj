<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows UI: the notification-area icon and its menu, the settings window, every sentence. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>FortiVPNManager.Ui</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The app is compiled ahead of time (Native AOT, os-integration/windows/App). The WinRT
         interop code generated for it uses unsafe code. -->
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Windows App SDK's WinUI component, which takes Foundation, InteractiveExperiences and Base.
         The tray icon's and the Community Toolkit's packages take the whole SDK, which NuGet would
         otherwise resolve to an older version; this pins it without taking its files. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\contract\windows\FortiVPNManager.Contract.csproj" />
  </ItemGroup>
  <!-- The macOS string catalog is the one source of the shared sentences; the Windows one names Windows. -->
  <ItemGroup>
    <EmbeddedResource Include="..\macos\Localizable.xcstrings" LogicalName="Localizable.xcstrings" />
    <EmbeddedResource Include="Windows.xcstrings" LogicalName="Windows.xcstrings" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FortiVPNManager.Ui.Tests" />
  </ItemGroup>
</Project>
