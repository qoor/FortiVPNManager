# FortiVPNManager build entry points. Requires Xcode (xcode-select -s /Applications/Xcode.app) and XcodeGen.

PROJECT      := FortiVPNManager.xcodeproj
SCHEME       := FortiVPNManager
DERIVED      := .build/xcode
CONFIG       ?= Debug
BUILD_NUMBER := $(shell date +%Y%m%d%H%M%S)
APP          := $(DERIVED)/Build/Products/$(CONFIG)/FortiVPNManager.app
HELPER       := $(APP)/Contents/MacOS/FortiVPNManagerHelper
INSTALLED    := /Applications/FortiVPNManager.app
APP_ID       := com.qoor.FortiVPNManager
HELPER_LABEL := com.qoor.FortiVPNManager.Helper
SUBSYSTEM    := com.qoor.FortiVPNManager

.PHONY: local-config gen build release test verify install run logs btm clean

## Create Config/Local.xcconfig with DEVELOPMENT_TEAM from the Apple Development certificate.
local-config:
	@team=$$(scripts/detect-team-id.sh) && \
	printf '// Generated by make local-config\nDEVELOPMENT_TEAM = %s\n' "$$team" > Config/Local.xcconfig && \
	echo "DEVELOPMENT_TEAM = $$team"

gen:
	@test -f Config/Local.xcconfig || $(MAKE) local-config
	xcodegen generate

build: gen
	xcodebuild -project $(PROJECT) -scheme $(SCHEME) -configuration $(CONFIG) \
		-derivedDataPath $(DERIVED) -allowProvisioningUpdates \
		CURRENT_PROJECT_VERSION=$(BUILD_NUMBER) build

release:
	$(MAKE) build CONFIG=Release

test:
	swift test --package-path Packages/FortiCore

## Signing sanity checks for the built app (see docs/DESIGN.md §7).
verify:
	@team=$$(scripts/detect-team-id.sh); \
	set -e; \
	echo "== app";    codesign -dv --verbose=2 "$(APP)" 2>&1 | grep -E '^(Identifier|TeamIdentifier)='; \
	echo "== helper"; codesign -dv --verbose=2 "$(HELPER)" 2>&1 | grep -E '^(Identifier|TeamIdentifier)='; \
	codesign --verify --strict --deep "$(APP)"; \
	codesign --verify -R="anchor apple generic and identifier \"$(APP_ID)\" and certificate leaf[subject.OU] = \"$$team\"" "$(APP)"; \
	codesign --verify -R="anchor apple generic and identifier \"$(HELPER_LABEL)\" and certificate leaf[subject.OU] = \"$$team\"" "$(HELPER)"; \
	test ! -e "$(APP)/Contents/embedded.provisionprofile" || { echo "unexpected provisioning profile"; exit 1; }; \
	! otool -L "$(HELPER)" | grep -q '@rpath' || { echo "helper links @rpath frameworks"; exit 1; }; \
	test -f "$(APP)/Contents/Library/LaunchDaemons/$(HELPER_LABEL).plist"; \
	echo "verify: OK"

## Install a Release build into /Applications (the only copy allowed to register the helper).
install: release
	-osascript -e 'tell application id "$(APP_ID)" to quit'
	@for i in $$(seq 1 15); do pgrep -x FortiVPNManager >/dev/null || break; sleep 1; done
	rm -rf "$(INSTALLED)"
	ditto "$(DERIVED)/Build/Products/Release/FortiVPNManager.app" "$(INSTALLED)"
	@# The old helper exits by itself once its binary is replaced (Helper/SelfUpdateWatcher.swift).
	open "$(INSTALLED)"

run:
	open "$(APP)"

logs:
	log stream --level debug --predicate 'subsystem == "$(SUBSYSTEM)"'

btm:
	sudo sfltool dumpbtm | grep -B2 -A12 -i fortivpnmanager

clean:
	rm -rf $(DERIVED) $(PROJECT)
