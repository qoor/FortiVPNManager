      }
    },
    "The connection request was rejected. Check the account details and VPN password. The Log tab shows why.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 요청이 거부됐습니다. 계정 정보와 VPN 비밀번호를 확인하세요. 이유는 로그 탭에 있습니다."
          }
        }
      }
    },
    "The connection was already started": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 연결을 시작했습니다"
          }
        }
      }
    },
    "The connection was closed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 닫혔습니다"
          }
        }
      }
    },
    "The file does not exist.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 없습니다."
          }
        }
      }
    },
    "The file has no password. Enter the VPN password above.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에 비밀번호가 없습니다. 위에서 VPN 비밀번호를 입력하세요."
          }
        }
      }
    },
    "The file is too large to be an OAuth client JSON.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth 클라이언트 JSON이라기에는 파일이 너무 큽니다."
          }
        }
      }
    },
    "The gateway doesn't allow SSL VPN tunnel mode.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이가 SSL VPN 터널 모드를 허용하지 않습니다."
          }
        }
      }
    },
    "The key '%@' appears more than once at the same level. Keep only one.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 '%@'가 같은 위치에 두 번 이상 있습니다. 하나만 남겨 주세요."
          }
        }
      }
    },
    "The openfortivpn config file has no host: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "openfortivpn 설정 파일에 host가 없습니다: %@"
          }
        }
      }
    },
    "The original file contains the password in plain text. The app never changes that file, so delete the password yourself if you don't need it.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 파일에 비밀번호가 평문으로 들어 있습니다. 앱은 원본을 고치지 않으니 필요 없으면 직접 지우세요."
          }
        }
      }
    },
    "The password was not saved to the Keychain because there is no username.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자명이 없어 비밀번호를 Keychain에 저장하지 않았습니다."
          }
        }
      }
    },
    "The port must be a number from 1 to 65535.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트는 1에서 65535 사이의 숫자여야 합니다."
          }
        }
      }
    },
    "The previous command has not finished": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 명령이 끝나지 않았습니다"
          }
        }
      }
    },
    "The server certificate was rejected after login.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 후 서버 인증서가 거부됐습니다."
          }
        }
      }
    },
    "The server closed the connection": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 연결을 닫았습니다"
          }
        }
      }
    },
    "The server closed the connection: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 연결을 닫았습니다: %@"
          }
        }
      }
    },
    "The server did not accept the OTP.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 OTP를 받아들이지 않았습니다."
          }
        }
      }
    },
    "The server rejected the login. Check the username and password.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 로그인을 거부했습니다. 사용자명과 비밀번호를 확인하세요."
          }
        }
      }
    },
    "The settings to save are invalid. %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장할 설정이 올바르지 않습니다. %@"
          }
        }
      }
    },
    "The top level of the config file must be in 'key: value' form.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 파일의 최상위는 '키: 값' 형식이어야 합니다."
          }
        }
      }
    },
    "The value of %@ has the wrong type. %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 값의 형식이 맞지 않습니다. %@."
          }
        }
      }
    },
    "This config file was written by a newer version of the app (schema_version %lld).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정 파일은 더 새로운 버전의 앱이 만든 형식입니다(schema_version %lld)."
          }
        }
      }
    },
    "This file has no Desktop app client. Download the JSON of an OAuth client of type Desktop app.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일에는 데스크톱 앱 클라이언트가 없습니다. 데스크톱 앱 유형 OAuth 클라이언트의 JSON을 다운로드하세요."
          }
        }
      }
    },
    "This file is not a Google OAuth client JSON.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 Google OAuth 클라이언트 JSON이 아닙니다."
          }
        }
      }
    },
    "This is a Web application client. Create an OAuth client of type Desktop app in Google Cloud Console and download its JSON.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 애플리케이션 유형의 클라이언트입니다. Google Cloud Console에서 데스크톱 앱 유형의 OAuth 클라이언트를 만들고 JSON을 다운로드하세요."
          }
        }
      }
    },
    "This is not a regular file.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 파일이 아닙니다."
          }
        }
      }
    },
    "This isn't a tested version (1.24.x). Its output may differ and connections may fail.": {
