            "state": "translated",
            "value": "재연결 대기 중 (%@)"
          }
        }
      }
    },
    "Write it as a decimal number without leading zeros (e.g. %@: 443).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0으로 시작하지 않는 10진수로 적어 주세요(예: %@: 443)."
          }
        }
      }
    },
    "Write numbers without quotes (e.g. %@: 443).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자는 따옴표 없이 적어 주세요(예: %@: 443)."
          }
        }
      }
    },
    "Write true/false without quotes (e.g. %@: true).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "true/false는 따옴표 없이 적어 주세요(예: %@: true)."
          }
        }
      }
    },
    "YAML syntax error (%@).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "YAML 문법 오류입니다(%@)."
          }
        }
      }
    },
    "YAML tags (%@) are not allowed. Write just the value, without a tag.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
