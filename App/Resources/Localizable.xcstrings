{
  "sourceLanguage": "en",
  "strings": {
    "%@ (%@ ago)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@ 전)"
          }
        }
      }
    },
    "%@ (%lld) must be less than %@ (%lld).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(%lld)는 %@(%lld)보다 작아야 합니다."
          }
        }
      }
    },
    "%@ Using the last valid settings.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 마지막 정상 설정으로 동작합니다."
          }
        }
      }
    },
    "%@ can't start or end with a space.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 값의 앞뒤에 공백을 둘 수 없습니다."
          }
        }
      }
    },
    "%@ contains a character that is not allowed (%@).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 쓸 수 없는 문자(%@)가 있습니다."
          }
        }
      }
    },
    "%@ contains characters that aren't allowed.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 값에 쓸 수 없는 문자가 있습니다."
          }
        }
      }
    },
    "%@ failed: %@: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 실패: %@: %@"
          }
        }
      }
    },
    "%@ has a quoted value \"%@\".": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 값 \"%@\"이(가) 따옴표로 감싸져 있습니다."
          }
        }
      }
    },
    "%@ is set to %@, which is not allowed. It must be %lld.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 값 %@은(는) 쓸 수 없습니다. %lld이어야 합니다."
          }
        }
      }
    },
    "%@ is set to %@, which is outside the allowed range (%lld–%lld).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 값 %@이(가) 허용 범위(%lld~%lld)를 벗어났습니다."
          }
        }
      }
    },
    "%@ is set to '%@', which is not allowed. Use one of: %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 값 '%@'은(는) 쓸 수 없습니다. 다음 중 하나로 적어 주세요: %@."
          }
        }
      }
    },
    "%@ is set to '%@', which is not allowed. Use true or false.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 값 '%@'은(는) 쓸 수 없습니다. true 또는 false로 적어 주세요."
          }
        }
      }
    },
    "%@ is set to '%@', which is not an accepted number format.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 값 '%@'은(는) 쓸 수 없는 숫자 형식입니다."
          }
        }
      }
    },
    "%@ is too long (at most %lld bytes).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 값이 너무 깁니다 (최대 %lld바이트)."
          }
        }
      }
    },
    "%@ rejected (%@): %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 거부됨 (%@): %@"
